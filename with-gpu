#!/usr/bin/env python3
"""Tiny cooperative FIFO GPU scheduler.

Usage:
  with-gpu <pool> [--num N] [--queue-dir DIR] [--interval SECONDS] -- <cmd> [args...]

Pools:
  any       any visible GPU
  2         only GPU 2
  0-3       GPUs 0,1,2,3
  0,2,3     GPUs 0,2,3

Examples:
  with-gpu any -- python train.py
  with-gpu any --num 2 -- torchrun --nproc_per_node=2 train.py
  with-gpu 0-3 --num 2 -- bash launch.sh
"""
from __future__ import annotations

import argparse
import datetime as dt
import errno
import fcntl
import json
import os
import signal
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any

DEFAULT_QUEUE_DIR = "/exp/exp4/gpu-queue"


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def boot_id() -> str:
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except Exception:
        return "unknown"


def run(cmd: list[str]) -> str:
    return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL)


def gpu_inventory() -> list[dict[str, Any]]:
    out = run([
        "nvidia-smi",
        "--query-gpu=index,uuid,name,memory.used,memory.total,utilization.gpu",
        "--format=csv,noheader,nounits",
    ])
    gpus = []
    for line in out.splitlines():
        if not line.strip():
            continue
        idx, gpu_uuid, name, mem_used, mem_total, util = [part.strip() for part in line.split(",", 5)]
        gpus.append({
            "index": int(idx),
            "uuid": gpu_uuid,
            "name": name,
            "mem_used": int(mem_used),
            "mem_total": int(mem_total),
            "util": int(util),
            "pids": [],
        })
    uuid_to_gpu = {gpu["uuid"]: gpu for gpu in gpus}
    try:
        apps = run([
            "nvidia-smi",
            "--query-compute-apps=gpu_uuid,pid,process_name,used_memory",
            "--format=csv,noheader,nounits",
        ])
    except subprocess.CalledProcessError:
        apps = ""
    for line in apps.splitlines():
        if not line.strip():
            continue
        parts = [part.strip() for part in line.split(",", 3)]
        if len(parts) != 4:
            continue
        gpu_uuid, pid, proc_name, used_memory = parts
        gpu = uuid_to_gpu.get(gpu_uuid)
        if gpu is None:
            continue
        user, cmd = process_info(pid)
        gpu["pids"].append({
            "pid": int(pid),
            "process": proc_name,
            "used_memory": int(used_memory),
            "user": user,
            "cmd": cmd,
        })
    return gpus


def process_info(pid: str) -> tuple[str, str]:
    try:
        out = subprocess.check_output(["ps", "-o", "user=,args=", "-p", str(pid)], text=True)
        line = out.strip()
        if not line:
            return "?", ""
        user, _, cmd = line.partition(" ")
        return user.strip(), cmd.strip()
    except Exception:
        return "?", ""


def parse_pool(pool: str, all_indices: list[int]) -> list[int]:
    if pool == "any":
        return list(all_indices)
    indices: list[int] = []
    for part in pool.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start_s, end_s = part.split("-", 1)
            start, end = int(start_s), int(end_s)
            if end < start:
                raise ValueError(f"invalid descending GPU range: {part}")
            indices.extend(range(start, end + 1))
        else:
            indices.append(int(part))
    seen = set()
    deduped = []
    for idx in indices:
        if idx not in all_indices:
            raise ValueError(f"GPU {idx} not present; available GPUs: {','.join(map(str, all_indices))}")
        if idx not in seen:
            seen.add(idx)
            deduped.append(idx)
    if not deduped:
        raise ValueError("empty GPU pool")
    return deduped


def ensure_dirs(queue_dir: Path) -> dict[str, Path]:
    paths = {
        "tickets": queue_dir / "tickets",
        "running": queue_dir / "running",
        "locks": queue_dir / "locks",
    }
    for path in paths.values():
        path.mkdir(parents=True, exist_ok=True)
    return paths


def lock_file(path: Path, blocking: bool = True):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o664)
    flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
    try:
        fcntl.flock(fd, flags)
        return fd
    except OSError as exc:
        os.close(fd)
        if exc.errno in (errno.EACCES, errno.EAGAIN):
            return None
        raise


def unlock_fd(fd: int | None) -> None:
    if fd is not None:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def ticket_path(paths: dict[str, Path], ticket_id: str) -> Path:
    return paths["tickets"] / f"{ticket_id}.json"


def create_ticket(paths: dict[str, Path], pool: str, pool_indices: list[int], num: int, cmd: list[str]) -> dict[str, Any]:
    created_ns = time.time_ns()
    ticket_id = f"{created_ns}-{socket.gethostname()}-{os.getpid()}-{uuid.uuid4().hex[:8]}"
    ticket = {
        "id": ticket_id,
        "created_ns": created_ns,
        "created_utc": utc_now(),
        "user": os.environ.get("USER", "unknown"),
        "host": socket.gethostname(),
        "pid": os.getpid(),
        "boot_id": boot_id(),
        "cwd": os.getcwd(),
        "pool": pool,
        "pool_indices": pool_indices,
        "num": num,
        "cmd": cmd,
    }
    ticket_path(paths, ticket_id).write_text(json.dumps(ticket, indent=2) + "\n")
    return ticket


def load_tickets(paths: dict[str, Path]) -> list[dict[str, Any]]:
    tickets = []
    for path in paths["tickets"].glob("*.json"):
        try:
            ticket = json.loads(path.read_text())
            ticket["_path"] = str(path)
            tickets.append(ticket)
        except Exception:
            continue
    tickets.sort(key=lambda t: (t.get("created_ns", 0), t.get("id", "")))
    return tickets


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def remove_stale_tickets(tickets: list[dict[str, Any]], current_boot_id: str) -> list[dict[str, Any]]:
    live = []
    host = socket.gethostname()
    for ticket in tickets:
        stale = False
        if ticket.get("host") == host:
            if ticket.get("boot_id") != current_boot_id:
                stale = True
            elif not pid_alive(int(ticket.get("pid", -1))):
                stale = True
        if stale:
            try:
                Path(ticket["_path"]).unlink(missing_ok=True)
            except Exception:
                pass
        else:
            live.append(ticket)
    return live


def externally_free_indices(gpus: list[dict[str, Any]]) -> list[int]:
    return [gpu["index"] for gpu in gpus if not gpu["pids"]]


def try_plan_for_ticket(ticket: dict[str, Any], available: list[int]) -> list[int] | None:
    allowed = [idx for idx in ticket["pool_indices"] if idx in available]
    if len(allowed) < int(ticket["num"]):
        return None
    return allowed[: int(ticket["num"])]


def fifo_plan(tickets: list[dict[str, Any]], available: list[int]) -> dict[str, list[int]]:
    remaining = list(available)
    plan = {}
    for ticket in tickets:
        chosen = try_plan_for_ticket(ticket, remaining)
        if chosen is None:
            # Strict-ish FIFO: stop at the first ticket that cannot currently run.
            break
        plan[ticket["id"]] = chosen
        remaining = [idx for idx in remaining if idx not in chosen]
    return plan


def acquire_gpu_locks(paths: dict[str, Path], indices: list[int]) -> list[int] | None:
    fds: list[int] = []
    for idx in indices:
        fd = lock_file(paths["locks"] / f"gpu{idx}.lock", blocking=False)
        if fd is None:
            for held in fds:
                unlock_fd(held)
            return None
        fds.append(fd)
    return fds


def truncate(text: str, width: int) -> str:
    text = text.replace("\n", " ")
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def fmt_age(created_ns: int) -> str:
    seconds = max(0, int((time.time_ns() - created_ns) / 1_000_000_000))
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return f"{h:02d}:{m:02d}:{s:02d}"


def render_table(headers: list[str], rows: list[list[str]]) -> str:
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))
    def line(left: str, mid: str, right: str) -> str:
        return left + mid.join("─" * (w + 2) for w in widths) + right
    out = [line("┌", "┬", "┐")]
    out.append("│ " + " │ ".join(h.ljust(widths[i]) for i, h in enumerate(headers)) + " │")
    out.append(line("├", "┼", "┤"))
    for row in rows:
        out.append("│ " + " │ ".join(row[i].ljust(widths[i]) for i in range(len(headers))) + " │")
    out.append(line("└", "┴", "┘"))
    return "\n".join(out)


def render_status(ticket: dict[str, Any], tickets: list[dict[str, Any]], gpus: list[dict[str, Any]], selected: list[int] | None, interval: int) -> str:
    ticket_rows = []
    for pos, t in enumerate(tickets[:12], start=1):
        marker = "← you" if t["id"] == ticket["id"] else ""
        cmd = " ".join(t.get("cmd", []))
        ticket_rows.append([
            str(pos),
            t["id"].split("-")[-1],
            t.get("pool", "?"),
            str(t.get("num", "?")),
            t.get("user", "?"),
            fmt_age(int(t.get("created_ns", 0))),
            truncate(cmd, 38),
            marker,
        ])
    gpu_rows = []
    for gpu in gpus:
        if gpu["pids"]:
            proc = gpu["pids"][0]
            state = "BUSY"
            who = f"{proc['user']}:{proc['pid']}"
            cmd = truncate(proc.get("cmd") or proc.get("process", ""), 34)
        else:
            state = "FREE"
            who = ""
            cmd = ""
        gpu_rows.append([
            str(gpu["index"]),
            state,
            f"{gpu['mem_used']}/{gpu['mem_total']} MiB",
            f"{gpu['util']}%",
            who,
            cmd,
        ])
    selected_txt = ",".join(map(str, selected)) if selected else "not yet"
    return "\n".join([
        f"GPU QUEUE — {socket.gethostname()} — {utc_now()}",
        f"Your ticket: {ticket['id'].split('-')[-1]}  request: {ticket['pool']}  num: {ticket['num']}  selected: {selected_txt}  waiting: {fmt_age(ticket['created_ns'])}",
        "",
        "Queue:",
        render_table(["Pos", "Ticket", "Pool", "Num", "User", "Wait", "Command", ""], ticket_rows or [["", "", "", "", "", "", "", ""]]),
        "",
        "GPUs:",
        render_table(["GPU", "State", "Memory", "Util", "User:PID", "Command"], gpu_rows),
        "",
        f"Waiting... next check in {interval}s. Ctrl-C removes your ticket.",
    ])


def print_status(text: str, tty: bool) -> None:
    if tty:
        sys.stderr.write("\033[2J\033[H" + text + "\n")
    else:
        first = text.splitlines()[1] if "\n" in text else text
        sys.stderr.write(f"[{utc_now()}] {first}\n")
    sys.stderr.flush()


def parse_cli(argv: list[str]) -> argparse.Namespace:
    if "--" not in argv:
        raise SystemExit("missing command separator; use: with-gpu <pool> [--num N] -- <command>")
    sep = argv.index("--")
    sched_args = argv[:sep]
    cmd = argv[sep + 1 :]
    if not cmd:
        raise SystemExit("missing command after --")

    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("pool", help="GPU pool: any, 2, 0-3, or 0,2,3")
    parser.add_argument("--num", type=int, default=1, help="number of GPUs required from the pool")
    parser.add_argument("--queue-dir", default=os.environ.get("GPU_QUEUE_DIR", DEFAULT_QUEUE_DIR))
    parser.add_argument("--interval", type=int, default=int(os.environ.get("CHECK_INTERVAL_SECONDS", "30")))
    args = parser.parse_args(sched_args)
    args.cmd = cmd
    if args.num < 1:
        parser.error("--num must be >= 1")
    return args


def main() -> int:
    args = parse_cli(sys.argv[1:])
    cmd = args.cmd

    try:
        gpus = gpu_inventory()
    except Exception as exc:
        print(f"with-gpu: failed to query GPUs: {exc}", file=sys.stderr)
        return 1
    all_indices = [gpu["index"] for gpu in gpus]
    try:
        pool_indices = parse_pool(args.pool, all_indices)
    except Exception as exc:
        print(f"with-gpu: {exc}", file=sys.stderr)
        return 2
    if args.num > len(pool_indices):
        print(f"with-gpu: --num {args.num} exceeds pool size {len(pool_indices)}", file=sys.stderr)
        return 2

    queue_dir = Path(args.queue_dir)
    paths = ensure_dirs(queue_dir)
    qlock_path = paths["locks"] / "queue.lock"
    my_ticket: dict[str, Any] | None = None
    gpu_lock_fds: list[int] = []
    running_meta: Path | None = None

    def cleanup(signum: int | None = None, frame: Any | None = None) -> None:
        if my_ticket is not None:
            ticket_path(paths, my_ticket["id"]).unlink(missing_ok=True)
        if running_meta is not None:
            running_meta.unlink(missing_ok=True)
        for fd in gpu_lock_fds:
            unlock_fd(fd)
        if signum is not None:
            raise SystemExit(128 + signum)

    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    qfd = lock_file(qlock_path)
    try:
        my_ticket = create_ticket(paths, args.pool, pool_indices, args.num, cmd)
    finally:
        unlock_fd(qfd)

    tty = sys.stderr.isatty()
    selected: list[int] | None = None
    while True:
        qfd = lock_file(qlock_path)
        try:
            tickets = remove_stale_tickets(load_tickets(paths), boot_id())
            gpus = gpu_inventory()
            available = externally_free_indices(gpus)
            plan = fifo_plan(tickets, available)
            selected = plan.get(my_ticket["id"])
            if selected is not None:
                fds = acquire_gpu_locks(paths, selected)
                if fds is not None:
                    # Re-check non-cooperative users after taking cooperative locks.
                    gpus = gpu_inventory()
                    available = externally_free_indices(gpus)
                    if all(idx in available for idx in selected):
                        gpu_lock_fds.extend(fds)
                        ticket_path(paths, my_ticket["id"]).unlink(missing_ok=True)
                        running_meta = paths["running"] / f"{my_ticket['id']}.json"
                        running = dict(my_ticket)
                        running["selected_gpus"] = selected
                        running["started_utc"] = utc_now()
                        running_meta.write_text(json.dumps(running, indent=2) + "\n")
                        break
                    for fd in fds:
                        unlock_fd(fd)
        finally:
            unlock_fd(qfd)

        print_status(render_status(my_ticket, tickets, gpus, selected, args.interval), tty)
        time.sleep(args.interval)

    if tty:
        sys.stderr.write("\033[2J\033[H")
    cuda_visible = ",".join(map(str, selected))
    print(f"[{utc_now()}] Acquired GPU(s) {cuda_visible}; running: {' '.join(cmd)}", file=sys.stderr)
    sys.stderr.flush()
    env = os.environ.copy()
    env["CUDA_VISIBLE_DEVICES"] = cuda_visible
    try:
        proc = subprocess.run(cmd, env=env)
        return proc.returncode
    finally:
        cleanup()


if __name__ == "__main__":
    raise SystemExit(main())
